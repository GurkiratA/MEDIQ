# MEDIQ server-side configuration (copy to `.env`, which is git-ignored).
#
# Every variable is OPTIONAL. With nothing configured, MEDIQ runs fully on its
# deterministic local fallbacks and labels every result accordingly.
#
# SECURITY: these are read only by the Node backend (server/). Never prefix a
# secret with VITE_ — Vite inlines VITE_* variables into the browser bundle.

# --- Model A: primary documentation model (OpenAI-compatible endpoint) -------
# Hermes 3 on a DigitalOcean 1-Click GPU Droplet, e.g.
#   DO_HERMES_BASE_URL=http://<droplet-ip>/v1
#   DO_HERMES_MODEL=NousResearch/Hermes-3-Llama-3.1-8B
# or DigitalOcean Serverless Inference with an open-weight model it lists, e.g.
#   DO_HERMES_BASE_URL=https://inference.do-ai.run/v1
#   DO_HERMES_MODEL=llama3.3-70b-instruct
DO_HERMES_API_KEY=
DO_HERMES_BASE_URL=
DO_HERMES_MODEL=

# --- Model B: Google Gemini safety auditor ----------------------------------
# gemini-2.0-flash was shut down on 2026-06-01. `gemini-flash-latest` is
# Google's alias for the current Flash model; pin a specific stable ID (check
# https://ai.google.dev/gemini-api/docs/models) if you need reproducibility.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Server -----------------------------------------------------------------
# MEDIQ_API_PORT=8787
# AI_TIMEOUT_MS=20000
