# MEDIQ — example environment file
# ===================================================================
# EVERYTHING HERE IS OPTIONAL in the default (bridge) mode. MEDIQ runs
# perfectly with an empty file — the bridge authenticates off your local agent session,
# login, and voice input and output both fall back to the browser's own speech.
# Copy this to .env.local, and add only what you actually want to change.
#
# The one line worth adding is ELEVENLABS_API_KEY, down in the BRIDGE section:
# it gives you a much better voice and Scribe transcription. The free tier is
# plenty for a demo. Never commit a real key.
#
# Two audiences read these variables:
#   - the BRIDGE (the Node server, bridge/server.mjs) reads the MEDIQ_* and
#     ELEVENLABS_API_KEY variables from its shell environment.
#   - the FRONTEND (the Vite app) reads the VITE_* variables from .env.local.
# Only VITE_-prefixed values ever reach the browser.


# ===================================================================
# BRIDGE (the server) — read from the shell that runs `npm run bridge`
# ===================================================================
# These are shown with their defaults. Leave them unset to accept the default.

# Port the bridge listens on (WebSocket + a few HTTP endpoints). Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# MEDIQ_BRIDGE_PORT=8787

# The model the bridge asks the agent to run. Default claude-sonnet-5.
# MEDIQ_MODEL=claude-sonnet-5

# Reasoning effort. Default medium.
# MEDIQ_EFFORT=medium

# Allow effectful tools (send, tap, delete, install, pay). Off by default, so
# MEDIQ can look at anything and change nothing. `npm run bridge:writes` sets
# this to 1 for you — read the decideTool gate in bridge/server.mjs first.
# MEDIQ_ALLOW_WRITES=0

# A narrower version of the above, just for Gmail (send/reply/label) through
# Zapier — lets MEDIQ actually send email without unlocking shell/file/Chrome
# writes too. MEDIQ_ALLOW_WRITES=1 already implies this; only set it
# separately if you want email writes on WITHOUT everything else. Off by
# default.
# MEDIQ_ALLOW_EMAIL_WRITES=0

# Extra browser origins allowed to open the agent WebSocket, comma separated.
# Local dev origins are already allowed; add others only if you serve the app
# from a different address. Default: none.
# MEDIQ_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (curl, scripts, native apps).
# Off by default, because that is also what local malware looks like. Default 0.
# MEDIQ_ALLOW_NO_ORIGIN=0

# Extra directories the bridge's /file endpoint may serve from, comma separated.
# Your home directory and the system temp directory are always included; this is
# for anything outside them, such as an external drive of footage. Default: none.
# MEDIQ_FILE_ROOTS=

# ElevenLabs voice id for the bridge's own speech endpoint.
# MEDIQ_VOICE_ID=HVls8FPCdrYsty3uUV9E

# ElevenLabs API key. Optional. With it, MEDIQ speaks in the ElevenLabs voice
# and transcribes with ElevenLabs Scribe; without it, everything still works on
# the browser's own speech. If you already have an elevenlabs MCP server in
# ~/.claude.json, the bridge reads the key from there and you can leave this
# blank. Default: none.
# ELEVENLABS_API_KEY=

# YouTube Data API key. Optional, but required for "play some music" / "put on
# that trailer" / "play the latest video from [channel]" — without it MEDIQ
# can still open a YouTube URL you give him, just not find one by name. Free:
# console.cloud.google.com -> create a project -> enable "YouTube Data API v3"
# -> Credentials -> Create API key. The free quota (10,000 units/day, ~100
# searches) is plenty for personal use. Default: none.
# YOUTUBE_API_KEY=

# Giphy API key. Optional — for "send me a gif of...". Free, instant:
# developers.giphy.com -> Create an App -> API key (not SDK). Default: none.
# GIPHY_API_KEY=

# Pexels API key. Optional — for "show me a picture of..." (a generic/stock
# subject). Free, instant, no billing: pexels.com/api -> sign up -> your API
# key is issued immediately. Default: none.
# PEXELS_API_KEY=

# SerpApi — for a picture of something SPECIFIC (a named landmark, a product,
# a logo) that stock photography won't have. Real Google Images results.
# Chosen over Google's own Custom Search API: Google's won't actually serve a
# request without a billing account (a real card) linked to the project, even
# within its free quota. SerpApi's free tier needs no card at all.
#   serpapi.com -> sign up (GitHub or Google login, no card) -> your API key
#   is on the dashboard. Free tier: 250 searches/month.
# Default: none.
# SERPAPI_API_KEY=

# Voice authentication (MEDIQ only responds to enrolled voices) needs no key
# at all — it runs on an open, published speaker-recognition model
# (speaker-model.mjs), downloaded once to ~/.mediq-voice on first use and
# cached from then on. No signup, no account, no expiry. Say "enroll my
# voice" to set it up; until then the feature is simply off and MEDIQ
# responds to anyone, same as always.

# Acceptance threshold for voice matching, 0 to 1. Higher = stricter (more
# likely to reject the right person too). Default 0.72 if unset — set higher
# than the model author's general-purpose 0.5 recommendation, since a false
# accept matters more here than a false reject; confirmed live that 0.5 let a
# parent and child through as the same profile (related voices are a known
# hard case for speaker verification generally). Raise further if a wrong
# voice still gets through; lower if the right voice gets rejected too often.
# VOICE_AUTH_THRESHOLD=0.72


# ===================================================================
# FRONTEND (Vite) — put these in .env.local
# ===================================================================

# Which brain the browser talks to. Default bridge.
#   bridge — talk to the local bridge (recommended). No API key, and every MCP
#            server in your agent config is available.
#   direct — the browser calls the Claude API itself. Needs VITE_ANTHROPIC_API_KEY.
# VITE_BACKEND=bridge

# Where the bridge listens. Keep the port in step with MEDIQ_BRIDGE_PORT above.
# Default ws://localhost:8787.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine, used when no ElevenLabs voice is active.
# Default system.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower to start.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george

# Prefer the ElevenLabs voice from the browser when a key is available.
# Default false.
# VITE_USE_ELEVENLABS=false

# Anthropic API key — DIRECT MODE ONLY. Required if and only if
# VITE_BACKEND=direct, and it ships to the browser, so use it only for a local
# demo. The default bridge mode never reads it. Default: none.
# VITE_ANTHROPIC_API_KEY=
